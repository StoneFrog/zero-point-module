# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual env
.venv/
venv/

# Env files (NEVER commit secrets)
.env
.env.local

# Dagster local instance state
dagster_home/storage/
dagster_home/history/
dagster_home/schedules/
dagster_home/.logs_queue/
dagster_home/logs/
dagster_home/compute_logs/
# Webserver UI onboarding flag (`seen: 1`), written on first visit.
dagster_home/.nux/

# Local data lake (when running outside docker)
.lake/
data/

# dbt artifacts (regenerated by `dbt parse`/`dbt build` — see docker-compose.yml)
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/
# Anonymous usage-tracking id dbt generates per installation. Not a
# secret, but it identifies one machine — a committed one would be
# shared by every clone.
dbt_project/.user.yml

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
