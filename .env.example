# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# --- ENTSO-E Transparency Platform ---
# Register at https://transparency.entsoe.eu/usrm/user/createPublicUser
# Then email transparency@entsoe.eu requesting API access; you'll receive a
# security token (a UUID). Until you have it, the pipeline runs against the
# bundled test fixture instead of the live API.
ENTSOE_API_TOKEN=

# Set to "true" to bypass the API and use tests/fixtures/ instead.
# Useful when the token isn't available yet, or for offline development.
ENTSOE_USE_FIXTURE=true

# --- MinIO / S3 ---
# These are the credentials docker-compose seeds MinIO with on first boot.
# The same values are used by Dagster/PyIceberg/DuckDB to read+write the lake.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKE_BUCKET=lake
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

# --- Dagster ---
# Host port for the Dagster web UI. Container always listens on 3000 internally;
# this just maps it to a host port. Change if 3001 collides locally.
DAGSTER_HOST_PORT=3001

# --- Postgres (shared metastore for the Iceberg REST catalog + Dagster + Superset) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lakehouse

# --- Iceberg REST catalog ---
# Currently points at the Apache Iceberg REST reference catalog
# (tabulario/iceberg-rest). Swap to a different REST catalog by changing
# this URL and the docker-compose service.
ICEBERG_CATALOG_URI=http://iceberg-catalog:8181

# --- Alerting (Phase 2, optional) ---
# Generic webhook URL, POSTed a small JSON payload ({"text": "..."}) when a
# Dagster run fails — works as-is with a Slack incoming webhook. Leave empty
# to skip external alerting; failures are still visible in the Dagster UI
# and daemon logs.
ALERT_WEBHOOK_URL=

# --- Superset ---
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@local
